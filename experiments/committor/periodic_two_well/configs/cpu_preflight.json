{
  "seed": 7,
  "device": "cpu",
  "dtype": "float64",
  "methods": [
    "simple_pinn",
    "boundary_adapted",
    "over_enforced",
    "under_enforced",
    "variational_nitsche"
  ],
  "problem": {
    "a": 1,
    "b": 0.6,
    "epsilon": 0.4,
    "source_center": [
      0.25,
      0
    ],
    "target_center": [
      0.75,
      0
    ],
    "set_radius": 0.5
  },
  "model": {
    "width": 4,
    "depth": 1,
    "activation": "tanh",
    "gain": 1,
    "architecture": "periodic_mlp",
    "initialization": "xavier_normal"
  },
  "training": {
    "epochs": 1,
    "collocation_points": 8,
    "boundary_points": 4,
    "learning_rate": 0.001,
    "checkpoint_every": 1,
    "monte_carlo": {
      "n_anchors": 1,
      "paths_per_anchor": 8,
      "dt": 0.01,
      "max_steps": 20,
      "seed": 19,
      "minimum_resolved_fraction": 0.5,
      "anchor_points": [
        [
          0.34,
          0
        ]
      ],
      "progress_interval_fraction": 0.01,
      "progress_interval_seconds": 10
    },
    "nitsche": {
      "volume_points": 8,
      "test_functions": 2,
      "boundary_points": 4,
      "length_scale": 0.15,
      "gamma": 10,
      "h": 0.1
    },
    "optimizer": {
      "name": "adam",
      "betas": [
        0.9,
        0.999
      ],
      "eps": 1e-8,
      "weight_decay": 0
    },
    "scheduler": {
      "name": "exponential",
      "gamma": 1
    },
    "log_interval_seconds": 0.01,
    "adaptive_loss_log_scale_init": 0
  },
  "reference_grid_sizes": [
    32,
    64
  ],
  "evaluation_batch_size": 512
}
