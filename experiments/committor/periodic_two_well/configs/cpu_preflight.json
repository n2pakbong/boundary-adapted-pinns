{
  "seed": 7,
  "device": "cpu",
  "dtype": "float64",
  "methods": [
    "boundary_adapted",
    "naive_product",
    "penalty"
  ],
  "problem": {
    "a": 1.0,
    "b": 0.6,
    "epsilon": 0.4,
    "source_center": [0.25, 0.0],
    "target_center": [0.75, 0.0],
    "set_radius": 0.5
  },
  "model": {
    "width": 8,
    "depth": 2,
    "activation": "tanh",
    "gain": 1.0
  },
  "training": {
    "epochs": 2,
    "collocation_points": 32,
    "boundary_points": 16,
    "boundary_weight": 100.0,
    "learning_rate": 0.001,
    "lr_gamma": 1.0,
    "checkpoint_every": 1,
    "log_every": 1
  },
  "reference_grid_sizes": [
    32,
    64
  ],
  "evaluation_batch_size": 4096
}
