{
  "seed": 7,
  "device": "cuda",
  "dtype": "float64",
  "methods": [
    "boundary_adapted",
    "naive_product",
    "penalty"
  ],
  "problem": {
    "a": 1.0,
    "b": 0.6,
    "epsilon": 0.4,
    "source_center": [0.25, 0.0],
    "target_center": [0.75, 0.0],
    "set_radius": 0.5
  },
  "model": {
    "width": 64,
    "depth": 4,
    "activation": "tanh",
    "gain": 1.0
  },
  "training": {
    "epochs": 6000,
    "collocation_points": 1024,
    "boundary_points": 256,
    "boundary_weight": 100.0,
    "learning_rate": 0.001,
    "lr_gamma": 0.9999,
    "checkpoint_every": 100,
    "log_every": 20
  },
  "reference_grid_sizes": [
    128,
    256
  ],
  "evaluation_batch_size": 16384
}
