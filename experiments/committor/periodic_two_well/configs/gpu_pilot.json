{
  "seed": 7,
  "device": "cuda",
  "dtype": "float64",
  "methods": [
    "simple_pinn",
    "boundary_adapted",
    "over_enforced",
    "under_enforced",
    "variational_nitsche"
  ],
  "problem": {
    "a": 1,
    "b": 0.6,
    "epsilon": 0.4,
    "source_center": [
      0.25,
      0
    ],
    "target_center": [
      0.75,
      0
    ],
    "set_radius": 0.5
  },
  "model": {
    "width": 64,
    "depth": 4,
    "activation": "tanh",
    "gain": 1,
    "architecture": "periodic_mlp",
    "initialization": "xavier_normal"
  },
  "training": {
    "epochs": 6000,
    "collocation_points": 1024,
    "boundary_points": 256,
    "learning_rate": 0.001,
    "checkpoint_every": 100,
    "monte_carlo": {
      "n_anchors": 32,
      "paths_per_anchor": 256,
      "dt": 0.001,
      "max_steps": 100000,
      "seed": 1007,
      "minimum_resolved_fraction": 0.9,
      "progress_interval_fraction": 0.01,
      "progress_interval_seconds": 10
    },
    "nitsche": {
      "volume_points": 1024,
      "test_functions": 32,
      "boundary_points": 512,
      "length_scale": 0.12,
      "gamma": 10,
      "h": 0.03
    },
    "optimizer": {
      "name": "adam",
      "betas": [
        0.9,
        0.999
      ],
      "eps": 1e-8,
      "weight_decay": 0
    },
    "scheduler": {
      "name": "exponential",
      "gamma": 0.9999
    },
    "log_interval_seconds": 30,
    "adaptive_loss_log_scale_init": 0
  },
  "reference_grid_sizes": [
    128,
    256
  ],
  "evaluation_batch_size": 16384
}
